# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - CAPA INTELIGENTE MOODLE (FISEI - UTA)
# ==============================================================================

# Entorno general
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Capa Inteligente de Seguimiento Académico para Moodle"

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS ACTIVA: SQL SERVER 2022 (MoodleUTADB) - Fase A
#    El middleware crea la base y su esquema al arrancar. Cambie la contraseña (política de SQL Server:
#    mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos).
# ------------------------------------------------------------------------------
MSSQL_HOST=sqlserver
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=Cambie_Esta_Clave_2026!
MSSQL_DB=MoodleUTADB

# PostgreSQL (Sprint 3): SIN USO desde la Fase A, se conserva sólo como vuelta atrás temporal
DB_HOST=analytics-db
DB_PORT=5432
DB_NAME=moodle_analytics
DB_USER=analytics_user
DB_PASSWORD=analytics_password_secret123

# ------------------------------------------------------------------------------
# 2. MOODLE LMS Y WEB SERVICES
# ------------------------------------------------------------------------------
MOODLE_SITE_NAME="Moodle UTA"
MOODLE_LANG=es
MOODLE_URL=http://moodle:8080
MOODLE_HOST_HEADER=localhost
MOODLE_EXTERNAL_URL=http://localhost:8080
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=MoodleAdmin2026!
MOODLE_ADMIN_EMAIL=admin@uta.edu.ec

# Token generado en Moodle (EduMonitor_WS)
MOODLE_TOKEN=edumonitorutadevtoken2026fisei01
MOODLE_WS_TOKEN=edumonitorutadevtoken2026fisei01

# Base de datos propia de Moodle (Bitnami MariaDB)
MOODLE_DB_HOST=moodle-db
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=bitnami_moodle
MOODLE_DB_USER=bn_moodle
MOODLE_DB_PASSWORD=moodle_db_pass_2026

# ------------------------------------------------------------------------------
# 3. MIDDLEWARE / BACKEND (FastAPI)
# ------------------------------------------------------------------------------
MIDDLEWARE_HOST=0.0.0.0
MIDDLEWARE_PORT=8000
MIDDLEWARE_URL=http://middleware:8000
JWT_SECRET=super_secret_jwt_key_uta_fisei_2026_sprint1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Login unificado (Fase A): el docente entra con su correo/usuario y contraseña de Moodle UTA
# (validados con login/token.php). EduMonitor no guarda contraseñas de docentes.
MOODLE_LOGIN_SERVICE=moodle_mobile_app
# Plazo por defecto (días) de las tareas de refuerzo publicadas en Moodle
REFUERZO_DIAS_PLAZO=7

# Persistencia: reintentos de conexión a SQL Server antes de usar el respaldo SQLite en memoria
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_SECONDS=2
SYNC_INTERVAL_SECONDS=300

# ------------------------------------------------------------------------------
# 4. AGENTE IA (Ollama SLM Local y Servicio de Inferencia)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
AGENT_URL=http://agent:8001
AGENT_PORT=8100
AGENT_SERVICE_TOKEN=agent_secret_token_uta_2026
AGENT_INFERENCE_TIMEOUT_SECONDS=10
HEURISTIC_FALLBACK_ENABLED=True

# ------------------------------------------------------------------------------
# 5. FRONTEND (Nginx)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
