# EduMonitor AI - Frontend React + Vite (Fase B)
# Copia del Dockerfile principal (frontend/Dockerfile) para el compose secundario docker/docker-compose.yml.
# El contexto de construcción debe ser la carpeta frontend/:
#   docker build -f docker/Dockerfile.frontend frontend
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# URL pública de Moodle UTA para enlaces externos (p. ej. recuperación de contraseña)
ARG VITE_MOODLE_URL=http://localhost:8080
ENV VITE_MOODLE_URL=$VITE_MOODLE_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
